# DevOpsArk observability (injected) — copy to .env and adjust
# OTLP (logs/traces/metrics export). Do not put /metrics on OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_EXPORTER_OTLP_ENDPOINT=<set DEVOPSARK_OTEL_COLLECTOR_OTLP_URL_PUBLIC on worker>

# Prometheus scrape (collector /metrics)
OTEL_COLLECTOR_METRICS_URL=<set DEVOPSARK_OTEL_COLLECTOR_METRICS_URL_PUBLIC on worker>

# Optional explicit public vs in-cluster (used when KUBERNETES_SERVICE_HOST is set)
# DEVOPSARK_OTEL_COLLECTOR_OTLP_URL_PUBLIC=
# DEVOPSARK_OTEL_COLLECTOR_OTLP_URL_CLUSTER=
# DEVOPSARK_OTEL_COLLECTOR_METRICS_URL_PUBLIC=
# DEVOPSARK_OTEL_COLLECTOR_METRICS_URL_CLUSTER=

OTEL_SERVICE_NAME="arkrn:project:a8bf51db-3da1-4059-947a-688fd96469ae:observabilityIntegration:e1ec66b8-4360-408d-8d8f-4f95872fbb59"
OTEL_EXPORT_BATCH_DELAY_MS=300
LOG_LEVEL=info
